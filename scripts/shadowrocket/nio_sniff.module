#!date=2026-08-31 18:23:00

[Script]
蔚来看板车况抓包 = type=http-request,pattern=^(https?:\/\/(icar|app|gateway-front-external)\.nio\.com|http:\/\/(boxjs\.(com|net)|nio\.(toys|local|box))),script-path=https://raw.githubusercontent.com/kissggj123/NIO-Dash-iOS/main/scripts/shadowrocket/nio_sniff.js,requires-body=false

[MITM]
hostname = %APPEND% icar.nio.com, app.nio.com, gateway-front-external.nio.com, boxjs.com, boxjs.net, nio.toys
